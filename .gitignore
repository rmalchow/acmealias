# Go
/backend/acmeservice
/backend/tmp/
*.test

# Angular console build output — embedded via go:embed at build time.
# Keep the fresh-clone placeholder so `go build` works before `ng build` runs.
/backend/internal/webui/dist/*
!/backend/internal/webui/dist/.gitkeep
!/backend/internal/webui/dist/index.html

# Frontend
/frontend/node_modules/
/frontend/.angular/

# Local dev stack state — see development/README or design D12.
/development/data/*
!/development/data/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Generated by development/scripts/lib.sh from example.com.zone.tmpl — the
# challenge CNAME targets the random alias label the seed created.
/development/dns/zones/example.com.zone

# The marketing site is built from site/src by site/build.sh.
/site/dist/

# The marketing site is copied in here by docker/Dockerfile.site before the Go
# build, exactly as the consoles are for internal/webui above. The placeholder
# index.html is committed for the same reason that one is: `go:embed` needs the
# directory to be non-empty at COMPILE time, so an ignored-but-absent dist makes
# `go build ./...` fail on a fresh clone.
/backend/cmd/acmesite/dist/*
!/backend/cmd/acmesite/dist/index.html

# A copied-and-filled example stack: its secrets and its state.
/examples/*/.env
/examples/*/data/
