# Go
/backend/acmeservice
/backend/tmp/
*.test

# Angular console build output — embedded via go:embed at build time.
# Keep the fresh-clone placeholder so `go build` works before `ng build` runs.
/backend/internal/webui/dist/*
!/backend/internal/webui/dist/.gitkeep
!/backend/internal/webui/dist/index.html

# Frontend
/frontend/node_modules/
/frontend/.angular/

# Local dev stack state — see development/README or design D12.
/development/data/*
!/development/data/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Generated by development/scripts/lib.sh from example.com.zone.tmpl — the
# challenge CNAME targets the random alias label the seed created.
/development/dns/zones/example.com.zone
