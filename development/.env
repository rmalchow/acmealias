# Development stack configuration — see design D12.
#
# This file does double duty, same as the production .env described in
# docs/installation.md: Compose reads it for ${...} interpolation, and the
# `api` service loads it as its env_file so the Go binary — which runs under
# air INSIDE the stack, not on the host — sees the same ACME_* variables the
# admin API needs. Every address below is therefore a container-network
# address. Nothing here is a secret worth protecting; it is throwaway local
# state.

# --- Postgres container ---
POSTGRES_USER=acmeservice
POSTGRES_PASSWORD=acmeservice
POSTGRES_DB=acmeservice

# --- Keycloak container ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Not plain `localhost`: the OIDC issuer must be one URL that works from the
# browser on the host AND from inside the api container. *.localhost resolves
# to loopback on the host by itself, and development/dns/hosts points it at
# the dev Traefik overlay for everything in the stack.
#
# A full URL rather than a bare host, because Keycloak has to know it is
# reached on :80 through the overlay and not on the :8082 it binds.
KC_HOSTNAME=http://keycloak.localhost
KC_HTTP_PORT=8082

# --- acmeservice, as consumed by the Go binary running under air ---
ACME_ZONE=dev.acmeservice.internal.
ACME_SOA_PRIMARY_NS=ns1.dev.acmeservice.internal.
ACME_SOA_HOSTMASTER=hostmaster@dev.acmeservice.internal
ACME_NS_NAMES=ns1.dev.acmeservice.internal.,ns2.dev.acmeservice.internal.

# ponytail: :8053 not :53 — the container would otherwise need
# CAP_NET_BIND_SERVICE, and 53 on this network belongs to CoreDNS, which
# forwards dev.acmeservice.internal here. Production binds :53 (see
# docs/installation.md); nothing else about the DNS server differs.
ACME_DNS_LISTEN=:8053
ACME_CHALLENGE_LISTEN=:8080
ACME_ADMIN_LISTEN=:8081
ACME_INTERNAL_LISTEN=127.0.0.1:9090

# The service connects as an ordinary role, never as the superuser: a superuser
# is exempt from every row-level security policy, so tenant isolation would be
# silently absent. The binary refuses to start as one.
ACME_DB_ROLE=acmeservice_app
ACME_DB_PASSWORD=acmeservice_app
ACME_DATABASE_URL=postgres://acmeservice_app:acmeservice_app@postgres:5432/acmeservice?sslmode=disable

# Alias labels: this stack runs the SHIPPED DEFAULT, a randomly generated
# label such as jxet64y6bngq4j37, because the fake internet's copy of the
# customer delegation is generated rather than checked in.
# development/scripts/seed.sh reads the label back out of
# `adminctl loadbalancer dns demo/prod` after creating the domains, renders
# development/dns/zones/example.com.zone from
# development/dns/zones/example.com.zone.tmpl with it, and restarts CoreDNS.
# Every reset therefore issues against a different label, which is precisely
# what the default's guarantee is worth testing.
#
# The option is still available: setting ACME_ALIAS_USE_DOMAIN=true here
# derives the label from the challenge name instead (demo.example.com becomes
# demo-example-com), which is what a single-organisation deployment that wants
# readable targets does. The generated zone follows either way.

# The dev overlay and traefik-lb are containers on the stack's subnet, so the
# X-Forwarded-For they set is only trusted from there.
ACME_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.28.0.0/24

# Record verification resolves through the fake internet's DNS, so the console
# sees exactly what the CA would see — including the customer-side CNAME in
# the hijacked example.com zone.
ACME_VERIFY_RESOLVER=172.28.0.53:53

# The dev-only Traefik overlay presents the console and its API on this one
# origin — design D12. Must exactly match the redirect URI registered on the
# Keycloak client in development/realm/acmeservice-realm.json.
ACME_OIDC_ISSUER=http://keycloak.localhost/realms/acmeservice
ACME_OIDC_CLIENT_ID=acmeservice-console
ACME_OIDC_CLIENT_SECRET=dev-console-secret
ACME_OIDC_REDIRECT_URL=http://acme-console.localhost/api/v1/auth/callback
ACME_OIDC_GROUPS_CLAIM=groups
ACME_OIDC_GROUP_PREFIX=

# Four global roles, mapped to the four groups in the realm export.
ACME_ADMIN_GROUP=acme-admin
ACME_CONFIG_ADMIN_GROUP=acme-config-admin
ACME_KEY_ROTATION_GROUP=acme-key-rotation
ACME_READ_ONLY_GROUP=acme-read-only

ACME_LOG_LEVEL=debug
