# .env for examples/external-idp — copy to .env, fill in, chmod 600.
#
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+='
# (no slashes or pluses: the database password ends up inside a postgres:// URL)

# --- hostnames (served by YOUR TLS proxy, see compose.yaml) -------------------
CONSOLE_HOST=console.example.com
# Optional staff console on its own hostname. Leave empty for none.
STAFF_HOST=
# Where sign-out lands; must be registered at the IdP as a post-logout
# redirect URI. Defaults to https://$CONSOLE_HOST/.
POST_LOGOUT_URL=

# --- the identity provider ----------------------------------------------------
# The issuer exactly as the provider's discovery document states it, e.g.
#   Keycloak   https://sso.example.com/realms/main
#   authentik  https://auth.example.com/application/o/acmealias/
#   Entra ID   https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=acmealias
OIDC_CLIENT_SECRET=
# Optional: the claim carrying group names, and a prefix to strip from each
# (Keycloak's full-path groups arrive as "/team").
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_PREFIX=
# The staff console's client, only if STAFF_HOST is set. Its redirect URI is
# https://$STAFF_HOST/api/admin/auth/callback.
STAFF_OIDC_CLIENT_ID=
STAFF_OIDC_CLIENT_SECRET=

# --- where things listen on this host -----------------------------------------
# The public IPv4 address DNS answers on. NOT 0.0.0.0 (see compose.yaml).
DNS_BIND=203.0.113.53
# The address your proxy reaches the HTTP port on.
HTTP_BIND=127.0.0.1
ACME_HTTP_PORT=8080
# Change only if it collides with an existing docker network.
NETWORK_SUBNET=172.29.53.0/24

# --- the zone this service is authoritative for --------------------------------
ACME_ZONE=acme.example.net.
ACME_SOA_PRIMARY_NS=ns1.example.com.
ACME_SOA_HOSTMASTER=hostmaster@example.com
ACME_NS_NAMES=ns1.example.com.,ns2.example.com.
ACME_CAA_ISSUER=letsencrypt.org

# --- image --------------------------------------------------------------------
IMAGE_TAG=latest

# --- postgres -----------------------------------------------------------------
POSTGRES_PASSWORD=
# The role the SERVICE connects as — not the superuser, which row-level
# security does not apply to. The binary refuses to start as a superuser.
ACME_DB_PASSWORD=

# --- policy -------------------------------------------------------------------
# true lets anyone who can sign in create team accounts. See compose.yaml.
ACME_ALLOW_ACCOUNT_CREATION=false

# --- mail (invitations) -------------------------------------------------------
MAIL_FROM=support@example.com
MAIL_SENDER=AcmeAlias
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
