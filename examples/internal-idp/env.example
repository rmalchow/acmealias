# .env for examples/internal-idp — copy to .env, fill in, chmod 600.
#
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+='
# (no slashes or pluses: two of these end up inside a postgres:// URL)

# --- hostnames (all served by YOUR TLS proxy, see compose.yaml) ---------------
CONSOLE_HOST=console.example.com
AUTH_HOST=auth.example.com
# Optional staff console on its own hostname. Leave empty for none.
STAFF_HOST=
# Where sign-out lands. Defaults to the console.
POST_LOGOUT_URL=

# --- where things listen on this host -----------------------------------------
# The public IPv4 address DNS answers on. NOT 0.0.0.0 (see compose.yaml).
DNS_BIND=203.0.113.53
# The address your proxy reaches the two HTTP ports on.
HTTP_BIND=127.0.0.1
ACME_HTTP_PORT=8080
AUTHENTIK_HTTP_PORT=9000
# Change only if it collides with an existing docker network.
NETWORK_SUBNET=172.29.53.0/24

# --- the zone this service is authoritative for --------------------------------
ACME_ZONE=acme.example.net.
ACME_SOA_PRIMARY_NS=ns1.example.com.
ACME_SOA_HOSTMASTER=hostmaster@example.com
ACME_NS_NAMES=ns1.example.com.,ns2.example.com.
ACME_CAA_ISSUER=letsencrypt.org

# --- image --------------------------------------------------------------------
# Pin to a commit SHA or release tag for a deployment that cannot move on its own.
IMAGE_TAG=latest

# --- postgres -----------------------------------------------------------------
POSTGRES_PASSWORD=
# The role the SERVICE connects as — not the superuser, which row-level
# security does not apply to. The binary refuses to start as a superuser.
ACME_DB_PASSWORD=
AUTHENTIK_DB_PASSWORD=

# --- authentik ----------------------------------------------------------------
AUTHENTIK_SECRET_KEY=
# The first administrator, created on first start. Sign in at
# https://$AUTH_HOST/if/admin/ with these.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# --- OIDC clients -------------------------------------------------------------
# The blueprint creates the providers with these and the service signs in with
# them — one value, two readers. Generate both; the staff one is needed even
# without a staff host, because the blueprint always creates that client.
OIDC_CLIENT_SECRET=
STAFF_OIDC_CLIENT_SECRET=

# --- mail ---------------------------------------------------------------------
# Used by authentik (address confirmation, password reset) and by the service
# (invitations). Without a relay nobody can finish registering.
MAIL_FROM=support@example.com
MAIL_SENDER=AcmeAlias
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS on 587, or implicit TLS on 465 — exactly one of these true.
SMTP_STARTTLS=true
SMTP_IMPLICIT_TLS=false
