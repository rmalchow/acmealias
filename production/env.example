# /docker/acme/.env — secrets and per-deployment values for the AcmeAlias stack.
#
# chmod 600. Everything here is either a secret or a value that differs between
# this host and any other; anything that is neither belongs in docker-compose.yml
# where it can be read without sudo.

# --- host addresses -----------------------------------------------------------
# The public addresses the DNS listener binds explicitly. NOT a wildcard: see the
# comment on the ports in docker-compose.yml — a wildcard collides with
# systemd-resolved on loopback and would publish IPv4 only.
HOST_IPV4=173.212.234.240
HOST_IPV6=2a02:c207:3016:439::1

# --- images ------------------------------------------------------------------
# Pin to a commit SHA to deploy an immutable build; `latest` follows whatever
# was last published by a tag pipeline.
IMAGE_TAG=

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# The role the SERVICE connects as. Deliberately not the superuser above: a
# superuser is exempt from every row-level security policy, so tenant isolation
# would be silently absent, and the binary refuses to start as one.
ACME_DB_ROLE=
ACME_DB_PASSWORD=

# --- authentik ---------------------------------------------------------------
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_NAME=
AUTHENTIK_DB_ROLE=
AUTHENTIK_DB_PASSWORD=
# The single root user. It is created on first start and is the only account
# that exists before anybody registers.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# --- the OIDC clients, shared between the blueprint and the service ----------
# The blueprint reads these to CREATE the providers; the service reads them to
# authenticate as one. They are the same values in two places by necessity, and
# a mismatch shows up as a sign-in that fails at the token exchange.
ACME_OIDC_CLIENT_ID=
ACME_OIDC_CLIENT_SECRET=
ACME_ADMIN_OIDC_CLIENT_ID=
ACME_ADMIN_OIDC_CLIENT_SECRET=

# --- mail --------------------------------------------------------------------
# Empty relay = no mail is sent at all, which breaks registration (the
# confirmation link) and invitations. Fill both sides in before opening the door.
# ONE MAILBOX, AUTHENTICATED AS ITSELF. The visible sender is the same address
# the relay authenticates as, which is not tidiness: IONOS refuses to send as an
# address the session did not log in as, and even where a relay allows it, a From
# that does not match the authenticated domain fails DMARC alignment — which does
# not bounce, it lands in spam, and is first reported as "I never got it".
ACME_MAIL_SMTP_ADDR=
ACME_MAIL_SMTP_USER=
ACME_MAIL_SMTP_PASSWORD=

AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=

# STARTTLS on 587. USE_SSL is implicit TLS on 465 and the two are mutually
# exclusive; setting both is a connection that hangs rather than an error.
AUTHENTIK_EMAIL__USE_TLS=
AUTHENTIK_EMAIL__USE_SSL=
# The DISPLAY NAME is part of the identity, not decoration. Both senders must
# spell it identically or mail clients thread them as two correspondents, and a
# customer hunting for an invitation finds a conversation that does not contain
# it. backend/acceptance/mail_test.go asserts exactly this pair.
AUTHENTIK_EMAIL__FROM=
